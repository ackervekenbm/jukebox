# Dependency installs run without lifecycle scripts.
#
# better-sqlite3 ships prebuilds/<platform>.node for every platform it supports,
# so nothing needs to be compiled — but its tarball still contains binding.gyp
# and npm's lockfile metadata does not carry the package's "gypfile": false
# opt-out, so npm otherwise runs a legacy implicit `node-gyp rebuild` on every
# install. That wants python3/make/g++ on the machine, silently recompiles
# SQLite on runners that do have them, and throws away the shipped prebuilds.
#
# Nothing else in this tree needs a script: esbuild is the only dependency with
# one, and it resolves its binary through the optional @esbuild/<platform>
# package. The Dockerfile and CI depend on this too, so a dependency that
# genuinely needs an install/postinstall script cannot be added without
# revisiting this file.
ignore-scripts=true
